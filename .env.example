# Every value here is a PLACEHOLDER. Nothing in this repo requires a key to run:
#   npm run demo  replays recorded cassettes with zero network calls.
# Keys are only needed to re-record cassettes (npm run record) or to drive a live tracker.

# ── Model provider ───────────────────────────────────────────────────────────
# cassette = replay from fixtures/cassettes (the default; no key needed)
MODEL_PROVIDER=cassette

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
# Output ceiling. Too low silently truncates a long inventory mid-manifest; the provider surfaces
# that as truncated=true rather than returning a short "successful" reply.
DEEPSEEK_MAX_OUTPUT_TOKENS=16384

ANTHROPIC_API_KEY=
# Do not hardcode a model id in code; verify the provisioned model before changing this default.
# claude-sonnet-5 is what the shipped parallel recording was made with (see PROVIDERS.md).
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_OUTPUT_TOKENS=16384

# Total wall-clock budget for one completion INCLUDING retries (not per attempt).
MODEL_TIMEOUT_MS=600000

# ── Tracker ──────────────────────────────────────────────────────────────────
# memory = in-process board seeded from a fixture (the default; no key needed)
TRACKER=memory

CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

LINEAR_API_KEY=

# ── Registry ─────────────────────────────────────────────────────────────────
OPS_REGISTRY_PATH=./config/ops-registry.json

# ── State ────────────────────────────────────────────────────────────────────
STATE_DIR=./.state

# ── Observability ────────────────────────────────────────────────────────────
# Spans are emitted through @opentelemetry/api and go nowhere until your app
# registers a tracer provider. There is no endpoint setting here on purpose:
# exporting is the host application's job, not this library's.
#
# Attach prompt and reply text to spans. OFF by default and it should stay off
# in anything resembling production — prompt text is the meeting itself, and a
# tracing backend is rarely held to the same access rules as the meeting was.
# When on, text is redacted for secrets and truncated.
OTEL_CAPTURE_IO=false
OTEL_CAPTURE_IO_MAX_CHARS=8000

# ── Agent layer (optional; PRD §5) ───────────────────────────────────────────
# A board agent above eight role agents. OFF by default — it is the one part of
# this repo written for it rather than extracted from production, so it does not
# stand in front of a first-time reader. It cannot write: role agents get a
# read-only adapter wrapper, and Pass 2c remains the only writer.
AGENTS_ENABLED=false
# Items handed to a role agent per run. Each is a model call.
AGENT_MAX_DELEGATIONS=8

# ── Tool loop (optional) ─────────────────────────────────────────────────────
# The default path pre-fetches evidence host-side and needs none of this. The
# read-only tool loop lets the model fetch card history itself; writes are
# refused by a wrapper around the adapter, not by asking the model nicely.
TOOL_LOOP_MAX_ITERATIONS=6

# ── Roles ────────────────────────────────────────────────────────────────────
# One <archetype>.md per entry in ROLE_ARCHETYPES. Rename the contents to your
# team; keep the filenames, since the registry validates a member's role
# against that union.
#
# Per-role state seeds live in <ROLES_DIR>/state/<archetype>.json and are
# version-controlled — that is where you add context ("Priya is on leave until
# the 14th"). Live state is written under STATE_DIR/roles/ after every run,
# because a file the pipeline rewrites constantly does not belong in git.
ROLES_DIR=./config/roles

# Total wall-clock budget for one tracker call INCLUDING retries.
TRACKER_TIMEOUT_MS=60000

# ── The rest of the knobs ────────────────────────────────────────────────────
# Everything below has a working default. They are listed because README calls
# this file "the configuration", and a live variable missing from it is a
# control nobody can find. `configDocumented.test.ts` fails if config.ts gains
# a key that never reaches this file.

# THE ONLY FAIL-CLOSED GUARD IN THE SYSTEM. When the ops registry is degraded
# (empty roster), the whole batch is held rather than written against nobody.
# Setting this false removes that protection and lets the run write anyway.
REGISTRY_FAIL_CLOSED=true

# Where an item goes when routing finds no list. Empty means "hold instead of
# guessing" — a wrong list is harder to notice than a hold.
CATCH_ALL_LIST_KEY=

# Transcript confidence thresholds. Below LOW, the prompt is told provenance is
# weak; below FLOOR, quoting the source verbatim is no longer trustworthy.
ASR_PROVENANCE_LOW=0.75
ASR_PROVENANCE_FLOOR=0.5

# Human corrections, fed back into later prompts. Defaults under STATE_DIR.
CORRECTIONS_PATH=

# Recorded model replies, one directory per provider/mode combination.
CASSETTE_DIR=./fixtures/cassettes
CASSETTE_DIR_ANTHROPIC=./fixtures/cassettes-anthropic
CASSETTE_DIR_AGENTS=./fixtures/cassettes-agents
CASSETTE_DIR_AGENTS_ANTHROPIC=./fixtures/cassettes-agents-anthropic
